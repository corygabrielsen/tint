#!/bin/sh
# =============================================================================
# tint - terminal background color picker
# https://github.com/corygabrielsen/tint
# =============================================================================
#
# Compatibility:
#   Interactive picker (no args) requires bash for read -n/-t support.
#   All other commands work with any POSIX shell (dash, ash, sh):
#     tint <color>    tint completions    tint hook    tint reset
#     tint --help     tint --list
#
#   Note: We use 'local' throughout. While not in POSIX spec, it's supported by
#   dash, ash, busybox sh, and every /bin/sh in practical use. See:
#   https://pubs.opengroup.org/onlinepubs/9699919799/utilities/V3_chap02.html
#   (Austin Group defect #767 - 'local' is planned for next POSIX revision)
#
# Install:
#   curl -fsSL https://raw.githubusercontent.com/corygabrielsen/tint/master/install.sh | bash
#
# Usage:
#   tint                      Interactive picker with live preview
#   tint <name|hex>           Set directly (e.g., "solarized", "#002b36")
#   tint random               Pick a random color
#   tint reset                Reset to terminal default
#   tint completions <shell>  Output shell completions (bash/zsh/fish)
#   tint hook <shell>         Output shell integration code
#   tint --help               Show help
#   tint --list               List available colors
#
# Library usage:
#   source /path/to/tint
#   tint_query                # Query current background
#   tint_resolve "solarized"  # Resolve name → #002b36
#   tint_set "#002b36"        # Set background
#   tint_reset                # Reset to default
#   tint_pick "$current"      # Interactive picker (0=selected, 1=cancelled)
#
# Configuration:
#   TINT_PALETTE_FILE     Custom palette file (one "name:#hex" per line)
#   TINT_PALETTE          Inline palette override (newline-separated)
#
# =============================================================================

TINT_VERSION="0.6.0"

# Escape character for POSIX compatibility
_TINT_ESC=$(printf '\033')

# Width of the colored strip in picker rows (index + hex + name)
_TINT_ROW_WIDTH=41

# =============================================================================
# Palette
# =============================================================================

_TINT_DEFAULT_PALETTE='
black:#000000
vscode:#1e1e1e
dracula:#282a36
nord:#2e3440
gruvbox:#282828
onedark:#282c34
monokai:#272822
catppuccin:#1e1e2e
tokyo:#1a1b26
solarized:#002b36
github:#0d1117
rose-pine:#191724
night-owl:#011627
ayu:#0a0e14
cobalt:#193549
darcula:#2b2b2b
everforest:#2d353b
forest:#1a2e1a
horizon:#1c1e26
kanagawa:#1f1f28
material:#263238
midnight:#1a1a2e
navy:#1b2838
obsidian:#0e0e10
oxblood:#2e1a1a
palenight:#292d3e
slate:#1e2030
synthwave:#262335
ubuntu:#300a24
'

# _tint_load_palette - Load and validate palette from env, file, or default
#
# See header comment re: 'local' keyword compatibility with POSIX shells.
#
# Sets: TINT_PALETTE
_tint_load_palette() {
    # Priority: TINT_PALETTE env > TINT_PALETTE_FILE > default
    local palette_source="${_TINT_PALETTE_INPUT:-}"
    # Check exists (-f), readable (-r), and guard with :- for set -u safety
    # Use || true so cat failure doesn't abort under set -e
    if [ -z "$palette_source" ] && [ -n "${TINT_PALETTE_FILE:-}" ] && [ -f "${TINT_PALETTE_FILE:-}" ] && [ -r "${TINT_PALETTE_FILE:-}" ]; then
        palette_source=$(cat "$TINT_PALETTE_FILE") || palette_source=""
    fi
    if [ -z "$palette_source" ]; then
        palette_source="$_TINT_DEFAULT_PALETTE"
    fi

    # Filter valid palette lines using sed and grep pipeline
    # 1. Strip inline comments and whitespace
    # 2. Remove empty lines and comment-only lines
    # 3. Keep only valid name:#hexcode format
    # Note: || true prevents exit under set -e if grep finds no matches
    TINT_PALETTE=$(printf '%s\n' "$palette_source" | \
        sed 's/ #.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' | \
        grep -v '^$' | \
        grep -v '^#' | \
        grep -E '^[a-zA-Z0-9][a-zA-Z0-9_-]*:#[0-9a-fA-F]{6}$' || true)
}

# Initialize palette
#
# Re-sourcing problem: _tint_load_palette sets TINT_PALETTE to filtered output.
# On re-source, we'd see that value and think it's a user override. To distinguish
# "user set TINT_PALETTE" from "we set it last time", we track three variables:
#
#   _TINT_USER_PALETTE   — snapshot of user's raw override (survives re-source)
#   _TINT_PALETTE_INPUT  — raw input fed to _tint_load_palette
#   _TINT_LOADED_PALETTE — our last processed output (for change detection)
#
# Update the snapshot when TINT_PALETTE is unset (user cleared it) or differs
# from our last load (user changed it).
if [ -z "${TINT_PALETTE+set}" ] || [ "${TINT_PALETTE:-}" != "${_TINT_LOADED_PALETTE:-}" ]; then
    _TINT_USER_PALETTE="${TINT_PALETTE:-}"
fi
_TINT_PALETTE_INPUT="${_TINT_USER_PALETTE:-}"
TINT_PALETTE=""
_tint_load_palette
_TINT_LOADED_PALETTE="$TINT_PALETTE"

# =============================================================================
# Palette Functions
# =============================================================================

# tint_lookup <name> - Look up color by name
#
# Stdout: #rrggbb hex value
# Returns: 0 if found, 1 if not found
tint_lookup() {
    local name="$1"
    local hex
    # Use awk for exact string matching - avoids regex metacharacter issues
    # (e.g., 'd.*' won't match 'dracula', '[' won't cause errors)
    hex=$(printf '%s\n' "$TINT_PALETTE" | awk -F: -v name="$name" '$1 == name {print $2; exit}')
    if [ -n "$hex" ]; then
        printf '%s' "$hex"
        return 0
    fi
    return 1
}

# tint_resolve <input> - Resolve name/hex/"reset" to hex (empty for "reset")
#
# Stdout: #rrggbb hex value (empty for "reset")
# Returns: 0 on success, 1 on failure (safe under set -e)
tint_resolve() {
    local input="$1"
    [ "$input" = "reset" ] && return 0
    # Expand 3-digit hex to 6-digit (#abc → #aabbcc)
    if printf '%s\n' "$input" | grep -qE '^#[0-9a-fA-F]{3}$'; then
        input="#$(printf '%s' "$input" | sed 's/^#\(.\)\(.\)\(.\)$/\1\1\2\2\3\3/')"
    fi
    printf '%s\n' "$input" | grep -qE '^#[0-9a-fA-F]{6}$' && { printf '%s' "$input"; return 0; }
    # Guard lookup failure to prevent set -e from aborting caller
    tint_lookup "$input" || return 1
}

# tint_list - Print all palette entries
#
# Stdout: name:#hex entries, one per line
tint_list() {
    printf '%s\n' "$TINT_PALETTE"
}

# tint_list_names - Print color names only
#
# Stdout: color names, one per line
tint_list_names() {
    printf '%s\n' "$TINT_PALETTE" | cut -d: -f1
}

# _tint_palette_get <n> - Get nth palette entry (1-indexed)
#
# Stdout: name:#hex entry
_tint_palette_get() {
    printf '%s\n' "$TINT_PALETTE" | sed -n "${1}p"
}

# _tint_palette_count - Get number of palette entries
#
# Stdout: integer count
_tint_palette_count() {
    # Count non-empty lines. grep -c exits non-zero when no matches,
    # so we capture output first to avoid || echo appending a second "0"
    local count
    count=$(printf '%s\n' "$TINT_PALETTE" | grep -c . 2>/dev/null) || count=0
    printf '%s' "$count"
}

# =============================================================================
# Terminal Functions
# =============================================================================

# tint_set <hex> - Set terminal background via OSC 11
#
# Why >/dev/tty 2>/dev/null?
#
# /dev/tty is a "magic" device that refers to the process's controlling terminal.
# It's not a real file - it's a kernel abstraction. The device node exists in the
# filesystem (so [ -e /dev/tty ] and [ -w /dev/tty ] return true), but writing to
# it fails with ENXIO ("No such device or address") when no terminal is attached.
#
# This happens in: cron jobs, systemd services, `dash -c '...'`, detached processes.
# We suppress stderr rather than pre-checking because:
#   1. [ -w /dev/tty ] tests permission bits, not device connectivity
#   2. [ -t 0 ] can be true while /dev/tty still fails (edge cases)
#   3. Silently failing is correct behavior - no terminal means nothing to tint
#
# Implementation notes:
#   - Subshell ( ... ) ensures the redirection error itself is captured
#   - 2>/dev/null on the subshell catches "No such device or address"
#   - || true prevents set -e from treating tty absence as fatal
#   - This pattern works across bash, dash, and other POSIX shells
#
tint_set() {
    ( printf '\033]11;%s\033\\' "$1" >/dev/tty ) 2>/dev/null || true
}

# tint_reset - Reset to terminal profile default via OSC 111
# See tint_set for /dev/tty handling explanation.
tint_reset() {
    ( printf '\033]111\033\\' >/dev/tty ) 2>/dev/null || true
}

# tint_query - Query current terminal background color
#
# Stdout: #rrggbb hex value
# Returns: 0 on success, 1 if terminal doesn't respond
tint_query() {
    local hex
    hex=$(_tint_query_raw) || return 1
    if [ -n "$hex" ]; then
        printf '%s' "$hex"
        return 0
    fi
    return 1
}

# _tint_query_raw - Run OSC 11 background query in an isolated subshell
#
# Uses ( ) instead of { } so trap/stty changes can't leak to caller.
# All terminal I/O goes through /dev/tty explicitly, so the subshell
# capture ($(...)) doesn't interfere with stdin/stdout.
#
# Timeout: stty `time 2` = 200ms. This is a deliberate tradeoff: long enough
# for all known local and remote terminals to respond (the response is a single
# write from the terminal emulator), but short enough that non-responding
# terminals (e.g. TERM=dumb, serial consoles) don't block for seconds.
#
# Stdout: #rrggbb hex value
# Returns: 0 on success, 1 if query fails
_tint_query_raw() (
    old_settings=$(stty -g 2>/dev/null </dev/tty) || exit 1
    stty raw -echo min 0 time 2 </dev/tty 2>/dev/null || {
        stty "$old_settings" </dev/tty 2>/dev/null
        exit 1
    }
    trap 'stty "$old_settings" </dev/tty 2>/dev/null' EXIT

    printf '\033]11;?\033\\' >/dev/tty
    response=$(dd bs=64 count=1 2>/dev/null </dev/tty | tr -d '\000')

    # Explicit restore (trap also fires on exit as safety net)
    stty "$old_settings" </dev/tty 2>/dev/null

    # Extract RGB: rgb:RRRR/GGGG/BBBB -> #RRGGBB (first 2 hex digits each)
    #
    # XParseColor allows 1-4 hex digits per component (h|hh|hhh|hhhh), but all known
    # terminals respond with 4 digits: xterm, VTE, urxvt, kitty, alacritty, foot (since
    # 2022). The regex requires 2+ digits, which safely handles all real-world responses.
    # See: https://codeberg.org/dnkl/foot/issues/971 (foot aligned to 4-digit standard)
    printf '%s' "$response" | sed -n 's/.*rgb:\([0-9a-fA-F]\{2\}\)[0-9a-fA-F]*\/\([0-9a-fA-F]\{2\}\)[0-9a-fA-F]*\/\([0-9a-fA-F]\{2\}\)[0-9a-fA-F]*.*/#\1\2\3/p'
)

# tint_supports_color - Check if terminal likely supports OSC color sequences
#
# This is a heuristic, not a guarantee. We check:
#   1. TERM is not "dumb" (indicates minimal/no capabilities)
#   2. /dev/tty is writable (we have a controlling terminal)
#
# Note: [ -t 1 ] (stdout is a tty) is insufficient - we write to /dev/tty,
# not stdout. A process can have stdout redirected but still have a
# controlling terminal, or vice versa.
#
# We don't detect terminal multiplexers (tmux/screen) here. OSC 11 may or
# may not work through them depending on configuration. Users in tmux who
# want to change the *outer* terminal color need passthrough sequences,
# which we don't currently support.
#
# Returns: 0 if color support is likely, 1 otherwise
tint_supports_color() {
    [ "${TERM:-dumb}" != "dumb" ] || return 1
    # Try opening /dev/tty for writing - this is the definitive check
    ( printf '' >/dev/tty ) 2>/dev/null || return 1
    return 0
}

# =============================================================================
# Interactive Picker
# =============================================================================
#
# State reference (all globals used by the picker subsystem):
#
#   Picker model          Type  Description      Set by
#   ────────────────────  ────  ───────────────  ───────────────────────────────────────────────────
#   _TINT_PK_IDX          int   cursor pos       init_picker, find_default_index, model_move_cursor
#   _TINT_PK_OLD_IDX      int   prev cursor pos  init_picker, model_move_cursor
#   _TINT_PK_DEFAULT      int   start pos        init_picker, find_default_index
#   _TINT_PK_TOTAL        int   entry count      load_palette_arrays
#   _TINT_PK_VISIBLE      int   window rows      init_picker
#   _TINT_PK_KEY          str   last keypress    read_key
#   _TINT_PK_EXIT_REASON  str   exit cause       install_signal_traps, accept_selection, picker_loop
#   _TINT_PK_SCROLLED     int   window shifted   init_picker, update_scroll_window
#   _TINT_PK_WIN_START    int   top visible idx  init_picker, update_scroll_window
#   _TINT_PK_WIN_END      int   bot visible idx  init_picker, update_scroll_window
#
#   Resource flags            Type             Description     Set by
#   ────────────────────────  ───────────────  ──────────────  ───────────────────────────────────────────────────
#   _TINT_PK_CURSOR_HIDDEN    bool             cursor hidden   install_signal_traps, hide_cursor, restore_terminal
#   _TINT_PK_TRAPS_INSTALLED  bool             traps set       install_signal_traps, restore_terminal
#   _TINT_PK_SAVED_STTY       str              original stty   install_signal_traps, setup_terminal
#   _TINT_PK_RENDERED_ROWS    int              rows on screen  init_picker, render_all, restore_terminal
#   _TINT_PK_PREVIEWED        bool             preview active  init_picker, apply_preview_color
#   _TINT_PK_INTERRUPTED      int (0/130/143)  signal code     install_signal_traps, traps
#   _TINT_PK_ORIGINAL_BG      str              starting bg     init_picker
#
#   Palette arrays (0 = "unchanged" entry)
#   Name            Type  Description
#   ──────────────  ────  ──────────────────────────────
#   _tint_names[i]  str   display name
#   _tint_hexes[i]  str   #RRGGBB
#   _tint_r/g/b[i]  int   RGB components
#   _tint_fg[i]     str   foreground ANSI ("30" or "97")
#
#   Session context (locals in tint_pick, visible via dynamic scoping)
#   Name                Type  Description
#   ──────────────────  ────  ────────────────────────────
#   _tint_saved_traps   str   caller's INT/TERM traps
#   _tint_saved_exit    str   caller's EXIT trap
#   _tint_esc_timeout   str   escape sequence timeout
#   _tint_read_timeout  str   keystroke polling timeout
#   last_idx            int   alias for _TINT_PK_TOTAL - 1

# --- Picker: Terminal Helpers ---

# _tint_hide_cursor - Hide the terminal cursor and set the hidden flag
#
# Sets: _TINT_PK_CURSOR_HIDDEN
# Flag set before write so a signal between them errs on the safe side
# (_tint_restore_terminal shows a cursor that was never hidden — harmless no-op).
_tint_hide_cursor() { _TINT_PK_CURSOR_HIDDEN=1; printf '\e[?25l' >/dev/tty; }

# _tint_get_terminal_height - Get the number of terminal lines
#
# Stdout: integer line count (defaults to 24)
_tint_get_terminal_height() {
    local n
    n=$(tput lines 2>/dev/null) || n="${LINES:-24}"
    case "$n" in *[!0-9]*|"") n=24 ;; esac
    printf '%s' "$n"
}

# _tint_erase_picker - Clear all picker output from the terminal
#
# Cursor is on the scroll indicator line (N rows below first palette row,
# which is 1 line below the hint line).
# Move up to the hint line and erase everything below.
# Note: if a signal fires mid-render, _TINT_PK_RENDERED_ROWS may not match
# the actual cursor position, causing \e[J to clear a few extra lines.
# Terminal clamps cursor-up at row 1, so this is cosmetic and transient.
_tint_erase_picker() {
    local n="${_TINT_PK_RENDERED_ROWS:-0}"
    if [ "$n" -gt 0 ]; then
        printf '\e[%dA' "$(( n + 1 ))" >/dev/tty
    fi
    # \e[J clears from cursor to end of screen without scrolling
    printf '\r\e[J' >/dev/tty
}

# --- Picker: Teardown ---

# _tint_restore_terminal - Unified teardown for all exit paths
#
# Idempotent: safe to call multiple times (signal handler + normal return).
# Uses resource flags to skip work that was never started or already undone.
#
# Reads: _TINT_PK_EXIT_REASON (decides whether to restore background color)
_tint_restore_terminal() {
    if [ "${_TINT_PK_CURSOR_HIDDEN:-0}" -eq 1 ]; then
        printf '\e[?25h' >/dev/tty
        _TINT_PK_CURSOR_HIDDEN=0
    fi
    if [ "${_TINT_PK_RENDERED_ROWS:-0}" -gt 0 ]; then
        _tint_erase_picker
        _TINT_PK_RENDERED_ROWS=0
    fi
    if [ -n "${_TINT_PK_SAVED_STTY:-}" ]; then
        stty "$_TINT_PK_SAVED_STTY" </dev/tty 2>/dev/null
    fi
    if [ "$_TINT_PK_EXIT_REASON" != "confirm" ]; then
        if [ -n "${_TINT_PK_ORIGINAL_BG:-}" ]; then
            tint_set "$_TINT_PK_ORIGINAL_BG"
        elif [ "${_TINT_PK_PREVIEWED:-0}" -eq 1 ]; then
            tint_reset
        fi
    fi
    if [ "${_TINT_PK_TRAPS_INSTALLED:-0}" -eq 1 ]; then
        trap - EXIT INT TERM
        eval "${_tint_saved_traps:-}"
        eval "${_tint_saved_exit:-}"
        _TINT_PK_TRAPS_INSTALLED=0
    fi
}

# --- Picker: Model ---

# _tint_model_move_cursor <direction> - Update cursor index with wrapping
#
# Pure model: no terminal I/O.
#
# Sets: _TINT_PK_IDX, _TINT_PK_OLD_IDX
_tint_model_move_cursor() {
    _TINT_PK_OLD_IDX=$_TINT_PK_IDX
    if [ "$1" = "up" ]; then
        _TINT_PK_IDX=$(( _TINT_PK_IDX > 0 ? _TINT_PK_IDX - 1 : last_idx ))
    else
        _TINT_PK_IDX=$(( _TINT_PK_IDX < last_idx ? _TINT_PK_IDX + 1 : 0 ))
    fi
}

# _tint_update_scroll_window - Compute the scroll window that keeps _TINT_PK_IDX visible
#
# Pure model: no terminal I/O.
# Edge-triggered: only shifts the window when the cursor would move off-screen.
# This minimizes full redraws (most keypresses stay within the window and use
# incremental rendering via _tint_render_changed_rows).
#
# Sets: _TINT_PK_WIN_START, _TINT_PK_WIN_END, _TINT_PK_SCROLLED
_tint_update_scroll_window() {
    local old_start=$_TINT_PK_WIN_START
    if [ "$_TINT_PK_VISIBLE" -ge "$_TINT_PK_TOTAL" ]; then
        _TINT_PK_WIN_START=0
        _TINT_PK_WIN_END=$(( _TINT_PK_TOTAL - 1 ))
    elif [ "${_TINT_PK_WIN_END:-0}" -eq 0 ] && [ "$_TINT_PK_RENDERED_ROWS" -eq 0 ]; then
        # Initial window: center around cursor
        local half=$(( _TINT_PK_VISIBLE / 2 ))
        _TINT_PK_WIN_START=$(( _TINT_PK_IDX - half ))
        if [ "$_TINT_PK_WIN_START" -lt 0 ]; then _TINT_PK_WIN_START=0; fi
        _TINT_PK_WIN_END=$(( _TINT_PK_WIN_START + _TINT_PK_VISIBLE - 1 ))
        if [ "$_TINT_PK_WIN_END" -ge "$_TINT_PK_TOTAL" ]; then
            _TINT_PK_WIN_END=$(( _TINT_PK_TOTAL - 1 ))
            _TINT_PK_WIN_START=$(( _TINT_PK_WIN_END - _TINT_PK_VISIBLE + 1 ))
        fi
    elif [ "$_TINT_PK_IDX" -lt "$_TINT_PK_WIN_START" ]; then
        _TINT_PK_WIN_START=$_TINT_PK_IDX
        _TINT_PK_WIN_END=$(( _TINT_PK_WIN_START + _TINT_PK_VISIBLE - 1 ))
    elif [ "$_TINT_PK_IDX" -gt "$_TINT_PK_WIN_END" ]; then
        _TINT_PK_WIN_END=$_TINT_PK_IDX
        _TINT_PK_WIN_START=$(( _TINT_PK_WIN_END - _TINT_PK_VISIBLE + 1 ))
    fi
    if [ "$_TINT_PK_WIN_START" -ne "$old_start" ]; then
        _TINT_PK_SCROLLED=1
    else
        _TINT_PK_SCROLLED=0
    fi
}

# --- Picker: View ---

# _tint_render_row <row_idx> <highlighted> - Append one formatted picker row to _tint_buf
#
# Accessed via dynamic scoping from the caller. Each row has:
#   - A 2-char prefix: "> " (cursor), "* " (default/current), or "  "
#   - A colored background strip with index, hex value, and name
#   - Highlighted rows are normal weight; others are dim (\e[2m)
#
# Reads: _TINT_PK_DEFAULT, _TINT_PK_TOTAL, _TINT_PK_ORIGINAL_BG,
#   _tint_names[], _tint_hexes[], _tint_r[], _tint_g[], _tint_b[], _tint_fg[]
_tint_render_row() {
    local row_idx="$1" highlighted="$2"
    local name hex r g b num_width fg marker label row
    num_width=${#_TINT_PK_TOTAL}

    if [ "$row_idx" -eq 0 ]; then
        if [ -n "$_TINT_PK_ORIGINAL_BG" ]; then name="(unchanged)"; else name="(reset to default)"; fi
        hex="$_TINT_PK_ORIGINAL_BG"
    else
        # shellcheck disable=SC3054
        name="${_tint_names[$row_idx]}"
        # shellcheck disable=SC3054
        hex="${_tint_hexes[$row_idx]}"
    fi

    # Build prefix: > for cursor, * for default, space otherwise.
    # Both row 0 (unchanged) and the matching palette entry get * because
    # they represent the same selection — choosing either preserves the current color.
    if [ "$highlighted" -eq 1 ]; then
        marker="> "
    elif [ "$row_idx" -eq "$_TINT_PK_DEFAULT" ] || { [ "$row_idx" -eq 0 ] && [ "$_TINT_PK_DEFAULT" -gt 0 ]; }; then
        marker="* "
    else
        marker="  "
    fi

    if [ -n "$hex" ]; then
        # shellcheck disable=SC3054
        r="${_tint_r[$row_idx]}" g="${_tint_g[$row_idx]}" b="${_tint_b[$row_idx]}"
        # shellcheck disable=SC3054
        fg="${_tint_fg[$row_idx]}"
        # shellcheck disable=SC3045
        printf -v label '%*d.    #%s    %s' "$num_width" "$((row_idx + 1))" "${hex#\#}" "$name"
        local padded
        # shellcheck disable=SC3045
        printf -v padded "%-${_TINT_ROW_WIDTH}s" "$label"
        if [ "$highlighted" -eq 1 ]; then
            # shellcheck disable=SC3045
            printf -v row '%s\e[%s;48;2;%d;%d;%dm %s\e[0m' "$marker" "$fg" "$r" "$g" "$b" "$padded"
        else
            # shellcheck disable=SC3045
            printf -v row '%s\e[2;%s;48;2;%d;%d;%dm %s\e[0m' "$marker" "$fg" "$r" "$g" "$b" "$padded"
        fi
    else
        # shellcheck disable=SC3045
        printf -v label '%*d.    - - - -    %s' "$num_width" "$((row_idx + 1))" "$name"
        local padded
        # shellcheck disable=SC3045
        printf -v padded "%-${_TINT_ROW_WIDTH}s" "$label"
        if [ "$highlighted" -eq 1 ]; then
            row="${marker}${padded}"
        else
            row="${marker}\e[2m${padded}\e[0m"
        fi
    fi
    # shellcheck disable=SC3054,SC3024,SC3003
    _tint_buf+=$'\r\e[K'"${row}"$'\n'
}

# _tint_apply_preview_color - Set terminal background to the highlighted color
#
# Provides live preview as the user navigates the picker.
#
# Sets: _TINT_PK_PREVIEWED
_tint_apply_preview_color() {
    if [ "$_TINT_PK_IDX" -eq 0 ]; then
        if [ -n "$_TINT_PK_ORIGINAL_BG" ]; then
            tint_set "$_TINT_PK_ORIGINAL_BG"
        elif [ "${_TINT_PK_PREVIEWED:-0}" -eq 1 ]; then
            tint_reset
        fi
    else
        _TINT_PK_PREVIEWED=1
        # shellcheck disable=SC3054
        tint_set "${_tint_hexes[$_TINT_PK_IDX]}"
    fi
}

# _tint_render_scroll_indicator - Append scroll indicator to _tint_buf
#
# Shows how many entries are hidden above/below (e.g., "↑ 3 more · ↓ 5 more").
_tint_render_scroll_indicator() {
    # shellcheck disable=SC3024,SC3003
    _tint_buf+=$'\r\e[K'
    local indicator=""
    if [ "$_TINT_PK_WIN_START" -gt 0 ] && [ "$_TINT_PK_WIN_END" -lt $(( _TINT_PK_TOTAL - 1 )) ]; then
        # shellcheck disable=SC3045
        printf -v indicator '\e[2m  \xe2\x86\x91 %d more \xc2\xb7 \xe2\x86\x93 %d more\e[0m' "$_TINT_PK_WIN_START" "$(( _TINT_PK_TOTAL - 1 - _TINT_PK_WIN_END ))"
    elif [ "$_TINT_PK_WIN_START" -gt 0 ]; then
        # shellcheck disable=SC3045
        printf -v indicator '\e[2m  \xe2\x86\x91 %d more\e[0m' "$_TINT_PK_WIN_START"
    elif [ "$_TINT_PK_WIN_END" -lt $(( _TINT_PK_TOTAL - 1 )) ]; then
        # shellcheck disable=SC3045
        printf -v indicator '\e[2m  \xe2\x86\x93 %d more\e[0m' "$(( _TINT_PK_TOTAL - 1 - _TINT_PK_WIN_END ))"
    fi
    # shellcheck disable=SC3024
    _tint_buf+="$indicator"
}

# _tint_render_all - Full redraw of the picker
#
# Repaints every visible row plus the scroll indicator. Output is
# buffered into _tint_buf and flushed in a single write() to avoid
# flicker and reduce PTY backpressure (especially over SSH).
#
# Callers must update model state (_tint_update_scroll_window) first.
#
# Sets: _TINT_PK_RENDERED_ROWS
_tint_render_all() {
    local i highlighted

    # Build entire frame into _tint_buf, then write in one shot.
    local _tint_buf=""

    # Move cursor up to first row position (for redraw).
    if [ "${_TINT_PK_RENDERED_ROWS:-0}" -gt 0 ]; then
        # shellcheck disable=SC3045
        printf -v _tint_buf '\e[%dA' "$(( _TINT_PK_RENDERED_ROWS ))"
    fi

    # Draw each visible row (appends to _tint_buf via dynamic scoping)
    local rows_printed=0
    i=$_TINT_PK_WIN_START
    while [ "$i" -le "$_TINT_PK_WIN_END" ]; do
        if [ "$i" -eq "$_TINT_PK_IDX" ]; then highlighted=1; else highlighted=0; fi
        _tint_render_row "$i" "$highlighted"
        rows_printed=$(( rows_printed + 1 ))
        i=$(( i + 1 ))
    done

    _tint_render_scroll_indicator
    printf '%s' "$_tint_buf" >/dev/tty
    _TINT_PK_RENDERED_ROWS=$rows_printed
}

# _tint_render_changed_rows <old_idx> - Incremental repaint of two changed rows
#
# Only repaints the previously highlighted row (unhighlight) and the newly
# highlighted row (highlight). Used when the scroll window hasn't changed,
# reducing output from ~2KB (full frame) to ~200B (two rows). This prevents
# PTY buffer deadlocks when the master side isn't draining continuously.
#
# Reads: _TINT_PK_IDX, _TINT_PK_WIN_START, _TINT_PK_RENDERED_ROWS
_tint_render_changed_rows() {
    local old_idx="$1"
    # shellcheck disable=SC3024,SC3003
    local _tint_buf="" _tmp=""
    local old_pos=$(( old_idx - _TINT_PK_WIN_START ))
    local new_pos=$(( _TINT_PK_IDX - _TINT_PK_WIN_START ))

    # Move from scroll indicator line up to old row
    # shellcheck disable=SC3045
    printf -v _tint_buf '\e[%dA' "$(( _TINT_PK_RENDERED_ROWS - old_pos ))"

    # Render old row (unhighlighted) — appends \r\e[K...row...\n to _tint_buf
    _tint_render_row "$old_idx" 0

    # Cursor is now at old_pos + 1; navigate to new_pos
    local diff=$(( new_pos - old_pos - 1 ))
    if [ "$diff" -gt 0 ]; then
        # shellcheck disable=SC3045
        printf -v _tmp '\e[%dB' "$diff"
        # shellcheck disable=SC3024
        _tint_buf+="$_tmp"
    elif [ "$diff" -lt 0 ]; then
        # shellcheck disable=SC3045
        printf -v _tmp '\e[%dA' "$(( -diff ))"
        # shellcheck disable=SC3024
        _tint_buf+="$_tmp"
    fi

    # Render new row (highlighted)
    _tint_render_row "$_TINT_PK_IDX" 1

    # Move back to scroll indicator line (cursor is at new_pos + 1)
    local down=$(( _TINT_PK_RENDERED_ROWS - new_pos - 1 ))
    if [ "$down" -gt 0 ]; then
        # shellcheck disable=SC3045
        printf -v _tmp '\e[%dB' "$down"
        # shellcheck disable=SC3024
        _tint_buf+="$_tmp"
    fi

    printf '%s' "$_tint_buf" >/dev/tty
}

# _tint_render_cursor_move - Render after a cursor move
#
# Applies preview color, then uses incremental rendering when the scroll
# window didn't change, falling back to full redraw when scrolling occurred.
#
# Reads: _TINT_PK_SCROLLED, _TINT_PK_OLD_IDX
_tint_render_cursor_move() {
    _tint_apply_preview_color
    # || true: render is non-fatal; prevents set -e abort on signal race
    if [ "$_TINT_PK_SCROLLED" -eq 1 ]; then
        _tint_render_all || true
    else
        _tint_render_changed_rows "$_TINT_PK_OLD_IDX" || true
    fi
}

# --- Picker: Input ---

# _tint_read_key - Read one logical keypress
#
# Reads raw bytes from /dev/tty and normalizes escape sequences into
# logical key names. Uses _tint_esc_timeout (set in _tint_setup_terminal)
# to distinguish bare Escape from arrow key sequences.
#
# Sets: _TINT_PK_KEY - normalized key name:
#   "up" | "down"     Arrow/vim keys
#   "confirm"         Enter key
#   "cancel"          Bare Esc (no following sequence)
#   "q"               Q key
#   ""                Timeout (no key pressed)
# Returns: 0 on success or timeout, 1 on EOF/error
_tint_read_key() {
    _TINT_PK_KEY=""
    local key key2 key3
    if ! IFS= read -rn1 -t "$_tint_read_timeout" key </dev/tty; then
        # Timeout with no data — loop back to check signals.
        # If a byte arrived at the timeout boundary, key is non-empty;
        # fall through to process it normally rather than aborting.
        if [ -z "${key:-}" ]; then return 0; fi
    fi
    case "$key" in
        "$_TINT_ESC")
            # CSI: ESC [ A/B/C/D (most terminals)
            # SS3: ESC O A/B/C/D (some terminals, notably older xterm modes)
            if IFS= read -rn1 -t "$_tint_esc_timeout" key2 </dev/tty 2>/dev/null; then
                case "$key2" in
                    "["|"O")
                        IFS= read -rn1 -t "$_tint_esc_timeout" key3 </dev/tty 2>/dev/null || return 0
                        case "$key3" in
                            A|D) _TINT_PK_KEY=up ;;   # Up/Left → up
                            B|C) _TINT_PK_KEY=down ;;  # Down/Right → down
                        esac
                        ;;
                esac
            else
                _TINT_PK_KEY=cancel
            fi
            ;;
        h|k) _TINT_PK_KEY=up ;;
        l|j) _TINT_PK_KEY=down ;;
        q)   _TINT_PK_KEY=q ;;
        "")  _TINT_PK_KEY=confirm ;;
    esac
}

# --- Picker: Session ---

# _tint_accept_selection - Confirm selection: teardown, apply color, print result
#
# Model: sets _TINT_PK_EXIT_REASON=confirm so _tint_restore_terminal skips
# background restore. View: tears down terminal, applies selected color,
# and prints hex to stdout.
#
# Stdout: #rrggbb hex of selected color (empty if reset)
_tint_accept_selection() {
    # Model: mark as confirmed
    _TINT_PK_EXIT_REASON=confirm
    # View: teardown and apply final color
    _tint_restore_terminal
    if [ "$_TINT_PK_IDX" -eq 0 ]; then
        if [ -n "$_TINT_PK_ORIGINAL_BG" ]; then
            tint_set "$_TINT_PK_ORIGINAL_BG"
            printf '%s' "$_TINT_PK_ORIGINAL_BG"
        else
            tint_reset
        fi
    else
        # shellcheck disable=SC3054
        tint_set "${_tint_hexes[$_TINT_PK_IDX]}"
        # shellcheck disable=SC3054
        printf '%s' "${_tint_hexes[$_TINT_PK_IDX]}"
    fi
}

# _tint_compute_foreground <idx> - Set _tint_fg[idx] based on RGB luminance
#
# Uses the perceived brightness formula (BT.601 luma) to pick
# black (30) or white (97) foreground for readability.
#
# Sets: _tint_fg[idx]
_tint_compute_foreground() {
    # shellcheck disable=SC3054
    if [ $(( (_tint_r[$1] * 299 + _tint_g[$1] * 587 + _tint_b[$1] * 114) / 1000 )) -gt 128 ]; then
        _tint_fg[$1]="30"
    else
        _tint_fg[$1]="97"
    fi
}

# _tint_load_palette_arrays - Parse palette into parallel arrays with pre-computed RGB/fg
#
# Single read pass over $TINT_PALETTE (~29 sed forks → 0).
#
# Sets: palette_count, _TINT_PK_TOTAL, last_idx (via dynamic scoping),
#   _tint_names[], _tint_hexes[], _tint_r[], _tint_g[], _tint_b[], _tint_fg[]
_tint_load_palette_arrays() {
    local hex name
    i=0
    while IFS=: read -r name hex; do
        # _tint_load_palette validates format, but guard here too for direct callers
        case "$hex" in '#'[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;; *) continue ;; esac
        i=$((i + 1))
        # shellcheck disable=SC3054
        _tint_names[i]="$name"
        # shellcheck disable=SC3054
        _tint_hexes[i]="$hex"
        # shellcheck disable=SC3054,SC3057,SC3052
        _tint_r[i]=$((16#${hex:1:2}))
        # shellcheck disable=SC3054,SC3057,SC3052
        _tint_g[i]=$((16#${hex:3:2}))
        # shellcheck disable=SC3054,SC3057,SC3052
        _tint_b[i]=$((16#${hex:5:2}))
        _tint_compute_foreground "$i"
    done <<EOF
$TINT_PALETTE
EOF
    palette_count=$i
    _TINT_PK_TOTAL=$(( palette_count + 1 ))
    last_idx=$(( _TINT_PK_TOTAL - 1 ))
}

# _tint_report_osc11_error - Print diagnostic when OSC 11 query fails
#
# Includes environment-specific hints for tmux and SSH.
_tint_report_osc11_error() {
    cat >&2 <<'ERRMSG'
Error: terminal does not support OSC 11 (background color escape sequences).

tint uses OSC 11 to get and set the terminal background color.
Your terminal did not respond to the background color query,
which means tint cannot preview or apply colors.
ERRMSG
    if [ -n "${TMUX:-}" ]; then
        echo "  Hint: try running: tmux set -g allow-passthrough on" >&2
    elif [ -n "${SSH_TTY:-}${SSH_CONNECTION:-}" ]; then
        echo "  Hint: try reconnecting with: ssh -t" >&2
    fi
    printf '%s\n' "  Try: printf '\033]11;?\033\\\\'" >&2
    printf '  A supported terminal will echo back the current background color.\n' >&2
}

# _tint_compute_unchanged_entry - Pre-compute RGB and foreground for the original background
#
# Sets: _tint_r[0], _tint_g[0], _tint_b[0], _tint_fg[0]
_tint_compute_unchanged_entry() {
    if [ -n "$_TINT_PK_ORIGINAL_BG" ]; then
        # shellcheck disable=SC3054,SC3057,SC3052
        _tint_r[0]=$((16#${_TINT_PK_ORIGINAL_BG:1:2}))
        # shellcheck disable=SC3054,SC3057,SC3052
        _tint_g[0]=$((16#${_TINT_PK_ORIGINAL_BG:3:2}))
        # shellcheck disable=SC3054,SC3057,SC3052
        _tint_b[0]=$((16#${_TINT_PK_ORIGINAL_BG:5:2}))
        _tint_compute_foreground 0
    fi
}

# _tint_find_default_index <current> - Match current color to a palette index
#
# Sets: _TINT_PK_IDX, _TINT_PK_DEFAULT (if a match is found)
# Reads: palette_count, _tint_hexes[] (via dynamic scoping)
_tint_find_default_index() {
    local current="$1"
    if [ -n "$current" ]; then
        local current_hex
        current_hex=$(tint_resolve "$current" 2>/dev/null | tr '[:upper:]' '[:lower:]') || current_hex=""
        if [ -n "$current_hex" ]; then
            i=1
            while [ "$i" -le "$palette_count" ]; do
                # shellcheck disable=SC3054
                if [ "$(printf '%s' "${_tint_hexes[$i]}" | tr '[:upper:]' '[:lower:]')" = "$current_hex" ]; then
                    _TINT_PK_IDX=$i
                    _TINT_PK_DEFAULT=$_TINT_PK_IDX
                    break
                fi
                i=$((i + 1))
            done
        fi
    fi
}

# _tint_install_signal_traps - Save caller traps and install picker signal handlers
#
# EXIT is saved separately — in command substitution (hex=$(tint_pick)),
# restoring EXIT would fire the caller's trap prematurely.
# Uses BASH_SUBSHELL (Bash 3.0+) instead of BASHPID (Bash 4.0+)
# for macOS Bash 3.2 compatibility.
#
# Sets: _tint_saved_traps, _tint_saved_exit, _TINT_PK_INTERRUPTED,
#   _TINT_PK_CURSOR_HIDDEN, _TINT_PK_EXIT_REASON, _TINT_PK_KEY,
#   _TINT_PK_SAVED_STTY, _TINT_PK_TRAPS_INSTALLED
_tint_install_signal_traps() {
    _tint_saved_traps=$(trap -p INT TERM 2>/dev/null || true)
    # shellcheck disable=SC3028
    if [ "${BASH_SUBSHELL:-0}" -eq 0 ]; then
        _tint_saved_exit=$(trap -p EXIT 2>/dev/null || true)
    else
        _tint_saved_exit=""
    fi

    # Flag-based signal handling avoids killing the parent shell when
    # sourced as a library. The read loop checks _TINT_PK_INTERRUPTED.
    _TINT_PK_INTERRUPTED=0
    _TINT_PK_CURSOR_HIDDEN=0
    _TINT_PK_EXIT_REASON=""
    _TINT_PK_KEY=""
    # Clear stale stty snapshot so a signal between trap install and the
    # new stty -g can't restore wrong state.
    _TINT_PK_SAVED_STTY=""
    # Install traps before stty -echo so a signal in the gap can't leave
    # the terminal with echo disabled.
    trap '_TINT_PK_EXIT_REASON=interrupt; _tint_restore_terminal' EXIT
    # 130 = 128+SIGINT, 143 = 128+SIGTERM (standard shell exit codes)
    trap '_TINT_PK_EXIT_REASON=interrupt; _tint_restore_terminal; _TINT_PK_INTERRUPTED=130' INT
    trap '_TINT_PK_EXIT_REASON=interrupt; _tint_restore_terminal; _TINT_PK_INTERRUPTED=143' TERM
    _TINT_PK_TRAPS_INSTALLED=1
}

# _tint_setup_terminal - Configure terminal for picker: stty, cursor, timeouts
#
# Sets: _TINT_PK_SAVED_STTY, _tint_esc_timeout, _tint_read_timeout
# Returns: non-zero if interrupted during setup
_tint_setup_terminal() {
    if [ "$_TINT_PK_INTERRUPTED" -ne 0 ]; then _tint_restore_terminal; return "$_TINT_PK_INTERRUPTED"; fi
    # Non-canonical mode: -echo suppresses keystroke echo, -icanon disables
    # line buffering. Without -icanon, bash's read -n1 toggles canonical mode
    # per call, creating a window for escape sequence byte delays.
    _TINT_PK_SAVED_STTY=$(stty -g </dev/tty 2>/dev/null)
    stty -echo -icanon </dev/tty 2>/dev/null
    _tint_hide_cursor

    # Timing constants for _tint_read_key:
    #
    #   _tint_esc_timeout  — distinguishes bare Escape (cancel) from the start
    #     of an arrow key sequence (ESC + "[" + letter). With -icanon set above,
    #     bytes arrive without line-buffering delays, so 10ms suffices. On very
    #     slow links where arrow keys don't register, vim keys (h/j/k/l) bypass
    #     this timeout entirely since they're single bytes.
    #
    #   _tint_read_timeout — main loop polling interval. Short enough to feel
    #     responsive, long enough that the signal-check loop doesn't busy-wait.
    #
    # Bash 4+ supports fractional timeouts; Bash 3.x needs integer (1s min).
    _tint_esc_timeout=0.01
    # shellcheck disable=SC3028
    _tint_read_timeout=0.5
    # shellcheck disable=SC3028
    if [ "${BASH_VERSINFO[0]:-3}" -lt 4 ]; then
        _tint_esc_timeout=1
        _tint_read_timeout=1
    fi
    if [ "$_TINT_PK_INTERRUPTED" -ne 0 ]; then _tint_restore_terminal; return "$_TINT_PK_INTERRUPTED"; fi
    printf '\e[2m  \xe2\x86\x91/\xe2\x86\x93 Navigate   Enter: Select   Esc: Cancel\e[0m\n' >/dev/tty
    # Model: compute scroll window for initial cursor position
    _tint_update_scroll_window
    # View: apply preview color and render initial frame
    _tint_apply_preview_color
    _tint_render_all
}

# _tint_init_picker [<current>] - Set up picker session state
#
# Loads palette, queries terminal, installs traps, renders initial frame.
#
# Sets (via dynamic scoping from tint_pick):
#   _tint_names[], _tint_hexes[], _tint_r[], _tint_g[], _tint_b[], _tint_fg[],
#   _tint_saved_traps, _tint_saved_exit, _tint_esc_timeout, _tint_read_timeout,
#   palette_count, last_idx
# Returns: non-zero on failure (no bash, no tty, no OSC 11 support)
_tint_init_picker() {
    _TINT_PK_IDX=0
    _TINT_PK_DEFAULT=0

    _tint_load_palette_arrays

    # Calculate visible window size based on terminal height
    local term_lines
    term_lines=$(_tint_get_terminal_height)
    _TINT_PK_VISIBLE=$(( term_lines - 2 ))  # reserve hint + scroll indicator
    if [ "$_TINT_PK_VISIBLE" -gt "$_TINT_PK_TOTAL" ]; then _TINT_PK_VISIBLE=$_TINT_PK_TOTAL; fi
    if [ "$_TINT_PK_VISIBLE" -lt 1 ]; then _TINT_PK_VISIBLE=1; fi
    _TINT_PK_RENDERED_ROWS=0
    _TINT_PK_WIN_START=0
    _TINT_PK_WIN_END=0
    _TINT_PK_OLD_IDX=0
    _TINT_PK_SCROLLED=0

    if ! _TINT_PK_ORIGINAL_BG=$(tint_query); then
        _tint_report_osc11_error
        return 1
    fi
    _TINT_PK_PREVIEWED=0

    _tint_compute_unchanged_entry
    _tint_find_default_index "${1:-}"
    _tint_install_signal_traps
    _tint_setup_terminal
}

# _tint_run_picker_loop - Input loop for the interactive picker
#
# Reads keystrokes via _tint_read_key and dispatches to action functions.
#
# Stdout: #rrggbb hex of selected color (on confirm only)
# Returns: 0 if color selected, 1 if cancelled or error
_tint_run_picker_loop() {
    while true; do
        if [ "$_TINT_PK_INTERRUPTED" -ne 0 ]; then _tint_restore_terminal; return "$_TINT_PK_INTERRUPTED"; fi
        # Timeout ensures signal flag (_TINT_PK_INTERRUPTED) gets checked even
        # when bash restarts read after a caught signal (SA_RESTART behavior).
        _tint_read_key || { _TINT_PK_EXIT_REASON=cancel; _tint_restore_terminal; return 1; }
        if [ "$_TINT_PK_INTERRUPTED" -ne 0 ]; then _tint_restore_terminal; return "$_TINT_PK_INTERRUPTED"; fi
        case "$_TINT_PK_KEY" in
            up|down)
                # Model
                _tint_model_move_cursor "$_TINT_PK_KEY"
                _tint_update_scroll_window
                # View
                _tint_render_cursor_move
                ;;
            q|cancel) _TINT_PK_EXIT_REASON=cancel; _tint_restore_terminal; return 1 ;;
            confirm)  _tint_accept_selection; return 0 ;;
        esac
    done
}

# tint_pick [<current>] - Interactive color picker with live preview
#
# Stdout: #rrggbb hex of selected color (on confirm only)
# Returns: 0 if color selected, 1 if cancelled or error
tint_pick() {
    # Bash required for read -n/-t used in interactive picker.
    # Test actual bash array syntax in a subshell — simple presence checks
    # like ${BASH_VERSINFO:-} can be fooled by env var spoofing (e.g.,
    # BASH_VERSINFO=5 in dash). Only real bash can parse array subscripts.
    # The subshell catches the fatal "Bad substitution" without killing us.
    # shellcheck disable=SC3028,SC3054
    if ! (eval '[ "${BASH_VERSINFO[0]+_}" = _ ]') 2>/dev/null; then
        printf 'tint_pick: requires bash\n' >&2
        return 1
    fi
    # TTY required for interactive display. CLI entry (_tint_main) checks this
    # before calling tint_pick, but library callers may invoke it directly in
    # headless contexts (e.g., scripts, CI). Guard here to fail early with a
    # clear message rather than dying on the first >/dev/tty write.
    if ! (: >/dev/tty) 2>/dev/null; then
        printf 'tint_pick: requires a terminal (no TTY detected)\n' >&2
        return 1
    fi

    # Session-scoped locals. Visible to _tint_init_picker, _tint_run_picker_loop,
    # _tint_restore_terminal, and render functions via bash dynamic scoping.
    local i palette_count last_idx
    # shellcheck disable=SC3054
    local -a _tint_names _tint_hexes _tint_r _tint_g _tint_b _tint_fg
    local _tint_saved_traps _tint_saved_exit
    local _tint_esc_timeout _tint_read_timeout

    _tint_init_picker "${1:-}" || return $?
    _tint_run_picker_loop
}

# =============================================================================
# Shell Completions
# =============================================================================
#
# Generated scripts hardcode "tint" as the command name (standard convention
# shared by direnv, zoxide, starship; matches the hook functions above).
# Users who rename the binary via symlink should search-and-replace "tint"
# with the new name in the generated output.
#
# All runtime lookups use `command tint` to bypass aliases/functions.

# _tint_completions_bash - Output bash tab completion code
#
# Outputs a completion function for bash's `complete` builtin.
# Designed for: eval "$(tint completions bash)"
_tint_completions_bash() {
    cat <<'BASH_COMP'
_tint_completions() {
    # COMP_WORDS and COMP_CWORD are always set by bash's completion system;
    # defensive defaults (${..-}) for set -u resilience at no cost.
    local cur opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]-}"

    # Second argument: shell name for completions/hook
    if (( COMP_CWORD == 2 )); then
        case "${COMP_WORDS[1]-}" in
            completions)
                COMPREPLY=( $(compgen -W "bash zsh fish" -- "$cur") ) ;;
            hook)
                COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") ) ;;
        esac
        return
    fi

    # No completions beyond second argument
    if (( COMP_CWORD > 2 )); then
        return
    fi

    # First argument: flags, subcommands, or color names
    opts="--help --list --names --query --version"
    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
    else
        local names
        names=$(command tint --names 2>/dev/null)
        COMPREPLY=( $(compgen -W "$names completions hook random reset" -- "$cur") )
    fi
}
complete -F _tint_completions tint
BASH_COMP
}

# _tint_completions_zsh - Output zsh tab completion code
#
# Outputs a compdef function for zsh's completion system.
# Designed for: eval "$(tint completions zsh)"
_tint_completions_zsh() {
    cat <<'ZSH_COMP'
#compdef tint

_tint() {
    local -a commands colors
    commands=(
        'completions:Output shell completions'
        'hook:Output shell integration code'
        'random:Pick a random color'
        'reset:Reset to terminal default'
        '--help:Show help'
        '--list:List available colors'
        '--names:List names only'
        '--query:Query current background'
        '--version:Show version'
    )
    colors=( ${(f)"$(command tint --names 2>/dev/null)"} )

    if (( CURRENT == 2 )); then
        _describe 'command' commands
        _describe 'color' colors
    elif (( CURRENT == 3 )); then
        case "${words[2]}" in
            completions)
                _values 'shell' bash zsh fish ;;
            hook)
                _values 'shell' bash zsh ;;
        esac
    fi
}

# compdef requires compinit; guard so eval before compinit doesn't error.
# Place eval after compinit in .zshrc for completions to register.
if (( $+functions[compdef] )); then
    compdef _tint tint
fi
ZSH_COMP
}

# _tint_completions_fish - Output fish tab completion code
#
# Outputs complete commands for fish's completion system.
# Designed for: tint completions fish > ~/.config/fish/completions/tint.fish
_tint_completions_fish() {
    cat <<'FISH_COMP'
# Fish completions for tint
complete -c tint -x

# True when completing the first argument (no positional arg entered yet)
function __tint_needs_command
    set -l cmd (commandline -opc)
    test (count $cmd) -eq 1
end

# Options (first argument only)
complete -c tint -n __tint_needs_command -l help -d 'Show help'
complete -c tint -n __tint_needs_command -l list -d 'List available colors'
complete -c tint -n __tint_needs_command -l names -d 'List names only'
complete -c tint -n __tint_needs_command -l query -d 'Query current background'
complete -c tint -n __tint_needs_command -l version -d 'Show version'

# Subcommands (first argument only)
complete -c tint -n __tint_needs_command -a 'completions' -d 'Output shell completions'
complete -c tint -n __tint_needs_command -a 'hook' -d 'Output shell integration code'
complete -c tint -n __tint_needs_command -a 'random' -d 'Pick a random color'
complete -c tint -n __tint_needs_command -a 'reset' -d 'Reset to terminal default'

# Subcommand arguments (second argument only)
complete -c tint -n 'test (count (commandline -opc)) -eq 2; and __fish_seen_subcommand_from completions' -xa 'bash zsh fish'
complete -c tint -n 'test (count (commandline -opc)) -eq 2; and __fish_seen_subcommand_from hook' -xa 'bash zsh'

# Color names (first argument only)
complete -c tint -n __tint_needs_command -a '(command tint --names 2>/dev/null)' -d 'Color name'
FISH_COMP
}

